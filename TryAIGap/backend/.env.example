# ===========================================
# TryAIGap Backend Environment Variables (.env)
# ===========================================

# Entorno general (dev / prod)
APP_ENV=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Seguridad y Autenticacion JWT
JWT_SECRET=tu_clave_secreta_jwt_para_desarrollo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15
DELEGATION_TTL_HOURS=72

# Base de Datos (SQLite para desarrollo local o PostgreSQL)
# Local SQLite: sqlite+aiosqlite:///./dev.db
# Local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/aiassessment
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Almacenamiento de Archivos y Evidencias
LOCAL_STORAGE_DIR=./_storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence

# Correo Electronico (Magic Links / Invitaciones)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@tryaigap.example

# Pasarela de Pagos Stripe (Modo Sandbox / Pruebas)
STRIPE_SECRET_KEY=sk_test_tu_clave_de_pruebas_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/estimator
